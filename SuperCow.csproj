<Project Sdk="Microsoft.NET.Sdk">
  
  <PropertyGroup>
    <AssemblyName>SuperCow</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <LangVersion>12.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>

    <ApplicationIcon>app.ico</ApplicationIcon>
    
    <RootNamespace />
  </PropertyGroup>

  <PropertyGroup Condition="Exists('content\DashboardIcon.ico')">
    <ApplicationIcon>content\DashboardIcon.ico</ApplicationIcon>
  </PropertyGroup>
  
  <ItemGroup>
    <Content Include="lib\FAudio.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>FAudio.dll</Link>
    </Content>
    <Content Include="lib\FNA3D.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>FNA3D.dll</Link>
    </Content>
    <Content Include="lib\SDL3.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>SDL3.dll</Link>
    </Content>
    <Content Include="content\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\FNA.NetStub\FNA.NetStub.csproj" />
    <ProjectReference Include="..\FNA\FNA.csproj" />
  </ItemGroup>
</Project>